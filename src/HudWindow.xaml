<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="HudWindow"
        Title="Codex Cache HUD"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <Style x:Key="HudIconButton" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#0A0A84FF" />
      <Setter Property="BorderBrush" Value="#220A84FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#FF0A84FF" />
      <Setter Property="FontFamily" Value="Segoe UI Symbol" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="IconChrome"
                    CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="IconChrome" Property="Background" Value="#180A84FF" />
                <Setter TargetName="IconChrome" Property="BorderBrush" Value="#520A84FF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="IconChrome" Property="Background" Value="#280A84FF" />
                <Setter Property="Opacity" Value="0.82" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HudListToggleButton" TargetType="{x:Type Button}">
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="Background" Value="#100A84FF" />
      <Setter Property="BorderBrush" Value="#260A84FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#FF0A84FF" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ToggleChrome"
                    CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ToggleChrome" Property="Background" Value="#1A0A84FF" />
                <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#520A84FF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ToggleChrome" Property="Background" Value="#280A84FF" />
                <Setter Property="Opacity" Value="0.84" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="HudScaleHost" Margin="18">
    <Border x:Name="HudShell"
            CornerRadius="22"
            Padding="16,11"
            BorderThickness="1"
            SnapsToDevicePixels="True">
      <Grid>
      <StackPanel x:Name="HudContentPanel">
        <Grid Width="680" Margin="2,1,2,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border x:Name="TransparentControlHitStrip"
                  Grid.ColumnSpan="2"
                  Height="34"
                  VerticalAlignment="Top"
                  Background="Transparent" />
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock x:Name="CacheChartTitle" Text="Codex 缓存命中率" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="CacheChartCaption" Text="最近 30 次调用 · 实时" Margin="0,2,0,0" FontSize="11" Opacity="0.65" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BackgroundOpacityButton"
                    Content="◐"
                    Margin="0,0,8,0"
                    Style="{StaticResource HudIconButton}"
                    ToolTip="调整背景可见度" />
            <Button x:Name="WindowSizeButton"
                    Content="⇲"
                    Margin="0,0,10,0"
                    Style="{StaticResource HudIconButton}"
                    ToolTip="调整悬浮窗大小" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="CacheChartLatest" Text="--" FontFamily="Segoe UI Variable Display, Microsoft YaHei UI" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Right" />
              <TextBlock x:Name="LaunchTokenUsage" Text="0 tokens" Margin="0,-2,0,0" FontSize="10" Opacity="0.62" HorizontalAlignment="Right" />
            </StackPanel>
          </StackPanel>
        </Grid>
        <Border x:Name="CacheChartFrame" Width="680" Height="205" Margin="2,10,2,0" CornerRadius="12" BorderThickness="1" BorderBrush="#180A84FF" Background="#060A84FF">
          <Grid Margin="11,10,11,8">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition x:Name="CacheChartFooterRow" Height="22" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border x:Name="CacheChartTopLine" Grid.Row="0" Height="1" Background="#1E64748B" VerticalAlignment="Top" />
              <Border x:Name="CacheChartMiddleLine" Grid.Row="1" Height="1" Background="#1464748B" VerticalAlignment="Center" />
              <Border x:Name="CacheChartBottomLine" Grid.Row="2" Height="1" Background="#1E64748B" VerticalAlignment="Bottom" />
              <Canvas x:Name="CacheChartCanvas" Grid.RowSpan="3" Width="620" Height="158" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Polyline x:Name="CacheHitLine" Stroke="#FF34C759" StrokeThickness="3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse x:Name="CacheLatestDot" Width="9" Height="9" Fill="#FF34C759" Visibility="Collapsed" />
              </Canvas>
              <TextBlock x:Name="CacheChartTopLabel" Grid.Row="0" Text="100%" FontSize="10" Opacity="0.5" HorizontalAlignment="Left" Margin="1,2,0,0" />
              <TextBlock x:Name="CacheChartMiddleLabel" Grid.Row="1" Text="50%" FontSize="10" Opacity="0.45" HorizontalAlignment="Left" VerticalAlignment="Center" />
              <TextBlock x:Name="CacheChartBottomLabel" Grid.Row="2" Text="0%" FontSize="10" Opacity="0.5" HorizontalAlignment="Left" Margin="1,0,0,2" />
            </Grid>
            <Grid Grid.Row="1" Margin="2,4,2,0">
              <TextBlock x:Name="CacheChartStart" Text="--:--:--" FontSize="10" Opacity="0.58" HorizontalAlignment="Left" />
              <TextBlock x:Name="CacheChartStatus" Text="等待 Codex 调用" FontSize="10" Opacity="0.58" HorizontalAlignment="Center" />
              <TextBlock x:Name="CacheChartEnd" Text="--:--:--" FontSize="10" Opacity="0.58" HorizontalAlignment="Right" />
            </Grid>
          </Grid>
        </Border>
        <Grid Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Ellipse x:Name="StatusDot"
                   Grid.Column="0"
                   Width="8"
                   Height="8"
                   Margin="0,0,12,0"
                   VerticalAlignment="Center" />
          <Button x:Name="TaskListToggleButton"
                  Grid.Column="2"
                  Visibility="Collapsed"
                  Margin="8,0,2,0"
                  HorizontalAlignment="Right"
                  Style="{StaticResource HudListToggleButton}"
                  FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
                  FontSize="12"
                  Cursor="Hand" />
          <WrapPanel x:Name="MetricsPanel"
                     Grid.Column="1"
                     Orientation="Horizontal"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     MaxWidth="350" />
        </Grid>
        <Border x:Name="TaskListDivider" Height="1" Background="#16000000" Margin="0,7,0,4" Visibility="Collapsed" />
        <ScrollViewer x:Name="TaskListScroller" MinWidth="900" MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <StackPanel x:Name="TaskListPanel" />
        </ScrollViewer>
        <Border x:Name="CallHistoryDivider" Height="1" Background="#16000000" Margin="0,7,0,7" Visibility="Collapsed" />
        <Grid x:Name="CallHistoryHeader" MinWidth="900" Margin="3,0,3,5" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="125" />
            <ColumnDefinition Width="145" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="115" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="最近调用" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1" Text="缓存命中" FontWeight="SemiBold" />
          <TextBlock Grid.Column="2" Text="缓存 / 输入" FontWeight="SemiBold" />
          <TextBlock Grid.Column="3" Text="未缓存" FontWeight="SemiBold" />
          <TextBlock Grid.Column="4" Text="缓存写入" FontWeight="SemiBold" />
          <TextBlock Grid.Column="5" Text="上下文" FontWeight="SemiBold" />
          <TextBlock Grid.Column="6" Text="状态" FontWeight="SemiBold" />
        </Grid>
        <ScrollViewer x:Name="CallHistoryScroller" MinWidth="900" MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <StackPanel x:Name="CallHistoryPanel" />
        </ScrollViewer>
      </StackPanel>
      <StackPanel x:Name="QuietIndicatorPanel"
                  Visibility="Collapsed"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <Grid x:Name="QuietOverallHost" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Ellipse x:Name="QuietOverallRing" Width="17" Height="17" StrokeThickness="1.5" Opacity="0.48" />
          <Ellipse x:Name="QuietOverallDot" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <Border x:Name="QuietIndicatorSeparator" Width="1" Height="18" Margin="10,0,9,0" VerticalAlignment="Center" Visibility="Collapsed" />
        <StackPanel x:Name="QuietTaskIndicators" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" />
      </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
