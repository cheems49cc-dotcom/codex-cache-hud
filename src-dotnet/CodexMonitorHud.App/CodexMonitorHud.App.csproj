<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <AssemblyName>CodexCacheHUD</AssemblyName>
    <RootNamespace>CodexMonitorHud.App</RootNamespace>
    <ApplicationIcon>..\..\assets\codex-monitor-hud.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>3.4.1</Version>
    <AssemblyVersion>3.4.1.0</AssemblyVersion>
    <FileVersion>3.4.1.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CodexMonitorHud.Core\CodexMonitorHud.Core.csproj" />
    <InternalsVisibleTo Include="CodexMonitorHud.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\src\HudWindow.xaml;..\..\src\TaskBubbleWindow.xaml" Link="src\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\locales\*.json" Link="locales\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\config.default.json" Link="config.default.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\pricing.default.json" Link="pricing.default.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\codex-monitor-hud.ico" Link="assets\codex-monitor-hud.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
